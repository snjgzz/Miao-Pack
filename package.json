{
  "name": "miao-pack",
  "version": "0.1.0",
  "description": "Browse and maintain local HTML design asset packs. Web UI for humans, MCP for agents.",
  "type": "module",
  "bin": {
    "miao-pack": "./dist/cli.js"
  },
  "files": [
    "dist",
    "web",
    "samples",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prestart": "npm run build",
    "start": "node dist/cli.js serve",
    "dev": "tsx src/cli.ts serve --root samples",
    "serve": "node dist/cli.js serve",
    "mcp": "node dist/cli.js mcp",
    "validate": "node dist/cli.js validate samples",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}
